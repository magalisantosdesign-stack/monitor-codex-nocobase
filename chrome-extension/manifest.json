{
  "manifest_version": 3,
  "name": "Monitor Codex — Conexão local",
  "version": "0.6.0",
  "description": "Inicia o script local do monitor somente ao clicar em Conectar no NocoBase.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:13000/*",
        "http://localhost:13000/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

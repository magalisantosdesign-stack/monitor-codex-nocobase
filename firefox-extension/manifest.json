{
  "manifest_version": 3,
  "name": "Monitor Codex — Conexão local",
  "version": "0.6.0",
  "description": "Inicia o script local do monitor somente ao clicar em Conectar no NocoBase.",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:13000/*",
        "http://localhost:13000/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "monitor-codex@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}

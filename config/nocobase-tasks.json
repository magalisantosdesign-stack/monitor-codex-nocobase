{
  "name": "codex_monitor_tasks",
  "title": "Tarefas do Monitor Codex",
  "template": "general",
  "fields": [
    {
      "name": "title",
      "title": "Nome da tarefa",
      "interface": "input",
      "validation": {
        "type": "string",
        "rules": [
          {
            "key": "required",
            "name": "required"
          },
          {
            "key": "max",
            "name": "max",
            "args": {
              "limit": 200
            }
          }
        ]
      }
    },
    {
      "name": "project",
      "title": "Projeto",
      "interface": "input"
    },
    {
      "name": "linkCodex",
      "title": "Link do chat Codex",
      "interface": "input"
    },
    {
      "name": "status",
      "title": "Situação da tarefa",
      "interface": "select",
      "defaultValue": "nao_iniciado",
      "enum": [
        {
          "value": "nao_iniciado",
          "label": "Não iniciado",
          "color": "default"
        },
        {
          "value": "em_andamento",
          "label": "Em andamento",
          "color": "blue"
        },
        {
          "value": "aguardando",
          "label": "Aguardando",
          "color": "gold"
        },
        {
          "value": "pausado",
          "label": "Pausado",
          "color": "orange"
        },
        {
          "value": "concluido",
          "label": "Concluído",
          "color": "green"
        }
      ]
    }
  ]
}
